FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-central.txt .
RUN pip install --no-cache-dir -r requirements-central.txt

COPY central_api ./central_api

CMD ["sh", "-c", "uvicorn central_api.app:app --host 0.0.0.0 --port ${PORT:-8080}"]
